#include <assert.h>
#include <ctype.h>
#include <limits.h>
#include <math.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* timeConversion(char* s) {
    int hh, mm, ss;
    char am_pm[3];
    
    sscanf(s, "%d:%d:%d%s", &hh, &mm, &ss, am_pm);
    
    if (strcmp(am_pm, "AM") == 0) {
        if (hh == 12) {
            hh = 0; // 12 AM becomes 00
        }
    } else { 
        if (hh != 12) {
            hh += 12; // 1 PM to 11 PM adds 12 hours
        }
    }
    
    char* result = malloc(10 * sizeof(char));
    
    sprintf(result, "%02d:%02d:%02d", hh, mm, ss);
    
    return result;
}

int main()
{
    FILE* fptr = fopen(getenv("OUTPUT_PATH"), "w");

    char* s = malloc(1024 * sizeof(char));
    scanf("%[^\n]", s);

    char* result = timeConversion(s);

    fprintf(fptr, "%s\n", result);

    fclose(fptr);
    free(result);
    free(s);

    return 0;
}
